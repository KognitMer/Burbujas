  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.47.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=20" }
}
